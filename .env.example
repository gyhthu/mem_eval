# Copy to .env only when you want to run Reader/Judge or a memory method that calls an LLM.
# Browsing the bundled questions, results, badcases and leaderboard needs no API key.

# Public DeepSeek development example
EVAL_LLM_PROVIDER=deepseek
EVAL_LLM_BASE_URL=https://api.deepseek.com
EVAL_LLM_API_KEY=replace_me
EVAL_READER_MODEL=deepseek-v4-flash
EVAL_JUDGE_MODEL=deepseek-v4-flash
EVAL_DEEPSEEK_THINKING=disabled

# Mem0 local embedding
EVAL_MEM0_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EVAL_MEM0_EMBEDDING_DIMS=512

# TeamAgent: L2 summary plus raw-message retrieval.
# This endpoint must implement OpenAI-compatible POST /embeddings.
EVAL_TEAMAGENT_MEMORY_MODEL=deepseek-v4-flash
EVAL_TEAMAGENT_EMBED_BASE_URL=http://127.0.0.1:11434/v1
EVAL_TEAMAGENT_EMBED_MODEL=bge-m3
EVAL_TEAMAGENT_EMBED_API_KEY=ollama
EVAL_TEAMAGENT_DISTILL_CONCURRENCY=8

# Company intranet example:
# EVAL_LLM_PROVIDER=openai
# EVAL_LLM_BASE_URL=http://internal-llm.example.com/v1
# EVAL_LLM_API_KEY=replace_with_internal_token
# EVAL_READER_MODEL=internal-reader-model
# EVAL_JUDGE_MODEL=internal-judge-model
